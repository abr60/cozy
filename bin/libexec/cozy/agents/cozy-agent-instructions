#!/bin/bash

# cozy:summary=Link every agent harness's global instructions to ~/.agents/AGENTS.md
# cozy:args=[--edit] [harness...]
# cozy:name=instructions
# cozy:group=agent
# cozy:examples=cozy agent instructions | cozy agent instructions --edit | cozy agent instructions opencode

# One set of personal agent rules, kept in ~/.agents/AGENTS.md beside the shared
# skills in ~/.agents/skills, and linked into the place each harness reads its
# global instructions from. Without harness names, only harnesses whose config
# directory already exists are linked, so nothing is created for agents that
# were never used; naming one links it regardless.
#
# omp, kimi and dsh read ~/.agents/AGENTS.md themselves. Crush and Amp read
# ~/.config/AGENTS.md. Hermes and OpenClaw keep an agent persona there instead
# of coding rules, and Cursor keeps user rules in its dashboard.

set -euo pipefail

edit=false
if [[ ${1:-} == "--edit" ]]; then
  edit=true
  shift
fi

header='<!-- Your instructions for every coding agent. Cozy links this file into each agent harness (Claude Code, Codex, Pi, OpenCode, and the rest), so what you write here applies to all of them. -->'
seed='<!-- For any Cozy dotfiles task, read the `cozy` skill before editing. -->'
canonical="$HOME/.agents/AGENTS.md"
config="${XDG_CONFIG_HOME:-$HOME/.config}"

declare -A links=(
  [config]="$config/AGENTS.md"
  [claude]="$HOME/.claude/CLAUDE.md"
  [codex]="$HOME/.codex/AGENTS.md"
  [pi]="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/AGENTS.md"
  [opencode]="${OPENCODE_CONFIG_DIR:-$config/opencode}/AGENTS.md"
  [agy]="$HOME/.gemini/config/AGENTS.md"
  [grok]="$HOME/.grok/AGENTS.md"
  [copilot]="${COPILOT_HOME:-$HOME/.copilot}/copilot-instructions.md"
  [qwen]="${QWEN_HOME:-$HOME/.qwen}/AGENTS.md"
  [mcode]="${MINIMAX_DATA_DIR:-$HOME/.minimax}/AGENTS.md"
  [kilo]="$config/kilo/AGENTS.md"
  [freebuff]="$HOME/.AGENTS.md"
)

mkdir -p "$(dirname "$canonical")"
[[ -e $canonical || -L $canonical ]] || printf '%s\n%s\n' "$header" "$seed" >"$canonical"

# Only our own header and hint count as "no rules yet".
blank() {
  local body
  body=$(grep -Fvx -e "$header" -e "$seed" "$canonical" 2>/dev/null || true)
  [[ -z $(printf '%s' "$body" | tr -d '[:space:]') ]]
}

link() {
  local target=$1
  # Rewrite our own links as relative ones (older versions wrote absolute links).
  if [[ -L $target ]] && [[ $target -ef $canonical ]]; then
    ln -sfn --relative -- "$canonical" "$target"
    return
  fi
  [[ $target -ef $canonical ]] && return

  if [[ -f $target ]]; then
    if blank; then
      if [[ -L $target ]]; then
        ln -sfn --relative -- "$(readlink -f "$target")" "$canonical"
      else
        mv -- "$target" "$canonical"
      fi
    elif ! cmp -s "$target" "$canonical"; then
      local backup="$target.bak"
      [[ -e $backup || -L $backup ]] && backup="$target.$(date +%Y%m%d%H%M%S).bak"
      mv -- "$target" "$backup"
      printf 'Kept your previous instructions as %s\n' "$backup" >&2
    fi
  elif [[ -e $target || -L $target ]]; then
    printf 'Skipping %s: not a file\n' "$target" >&2
    return
  fi

  mkdir -p "$(dirname "$target")"
  ln -sfn --relative -- "$canonical" "$target"
  printf 'Linked %s -> %s\n' "$target" "$(readlink "$target")"
}

if (($#)); then
  for harness in "$@"; do
    case "$harness" in
      omp | kimi | dsh) ;;
      crush | amp) link "${links[config]}" ;;
      *)
        [[ -n ${links[$harness]:-} ]] || {
          printf 'Unknown harness: %s\n' "$harness" >&2
          exit 1
        }
        link "${links[$harness]}"
        ;;
    esac
  done
else
  for harness in "${!links[@]}"; do
    target=${links[$harness]}
    if [[ $harness == freebuff ]]; then
      [[ -L $target ]] && link "$target"
    elif [[ -d $(dirname "$target") ]]; then
      link "$target"
    fi
  done
fi

if blank; then
  printf '%s\n%s\n' "$header" "$seed" >"$canonical"
fi

if [[ $edit == true ]]; then
  read -ra editor <<<"${VISUAL:-${EDITOR:-vi}}"
  exec "${editor[@]}" "$canonical"
fi
