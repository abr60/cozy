#!/usr/bin/env bash
# cozy:summary=Open the Cozy toolbox hub
# =============================================================================
# Toolbox – Unified Hub Launcher
# =============================================================================

TOOLBOX_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

MEDIA="$TOOLBOX_DIR/cozy-media-download"
DOTS="$TOOLBOX_DIR/cozy-dots-push"
GIF="$TOOLBOX_DIR/cozy-mp4-to-gif"
WG="$TOOLBOX_DIR/cozy-wg-manager"
SCAN="$TOOLBOX_DIR/cozy-clamav-scanner"
SPOOF="$TOOLBOX_DIR/cozy-mac-spoofer"
META="$TOOLBOX_DIR/cozy-metadata-cleaner"
SHRED="$TOOLBOX_DIR/cozy-shredder"
SPOTI="$TOOLBOX_DIR/cozy-spotify-music-download"
WIFIQR="$TOOLBOX_DIR/cozy-wifi-qr"

launch_tui() {
    local script="$1"
    local title="$2"
    uwsm-app -- foot --title="$title" -e bash "$script" &
}

MENU="  Github Push
  YTdlp
  Spotify
󰿔  MP4 → GIF
󰖩  WiFi QR"

chosen=$(echo -e "$MENU" | rofi -dmenu \
    -i \
    -p "󱁤 Toolbox" \
    -kb-cancel "Escape,MouseSecondary,MousePrimary")

[[ -z "$chosen" ]] && exit 0

case "$chosen" in
    *"YTdlp"*)       launch_tui "$MEDIA" "media-download" ;;
    *"Github Push"*) launch_tui "$DOTS"  "dots-push"      ;;
    *"MP4"*)         launch_tui "$GIF"   "mp4-to-gif"     ;;
    *"WireGuard"*)   bash "$WG"    &                      ;;
    *"Malware"*)     bash "$SCAN"  &                      ;;
    *"MAC Spoofer"*) bash "$SPOOF" &                      ;;
    *"Metadata"*)    bash "$META"  &                      ;;
    *"Spotify"*)     launch_tui "$SPOTI" "cozy-spotify-music-download" ;;
    *"Shredder"*)    bash "$SHRED" &                      ;;
    *"WiFi QR"*)     uwsm-app -- foot --title=wifi-qr -e bash "$WIFIQR" & ;;
esac
