#!/bin/bash

# cozy:summary=Prompt for text input with Walker
# cozy:group=menu
# cozy:name=input
# cozy:args=prompt [walker args...]
# cozy:examples=cozy menu input Reminder|menu-input "Reminder in minutes" --width 400

set -euo pipefail

prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

walker-dmenu --inputonly --width 295 --minheight 1 --maxheight 1 -p "$prompt…" "$@" 2>/dev/null
