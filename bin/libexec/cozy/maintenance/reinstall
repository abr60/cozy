#!/bin/bash

# cozy:summary=Reinstall Cozy packages and reset default configs
# cozy:requires-sudo=true

set -e

# Attempt to reinstall all default Cozy packages and reset all the default configs.

echo -e "This will reinstall all the default Cozy packages and reset all default configs.\nWarning: All user changes to configs will be lost.\n"

if gum confirm "Are you sure you want to reinstall and lose all config changes?"; then
  reinstall-git
  reinstall-pkgs
  reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && system-reboot
fi
