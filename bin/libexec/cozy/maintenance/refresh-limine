#!/usr/bin/env bash
# cozy:summary=Refresh Limine config, rebuild UKIs, and sync snapshots

set -euo pipefail

COZY_DIR="${COZY_DIR:-$HOME/.local/share/Cozy}"

if [[ -x "$COZY_DIR/install/login/limine.sh" ]]; then
  exec bash "$COZY_DIR/install/login/limine.sh"
fi

echo "ERROR: $COZY_DIR/install/login/limine.sh not found" >&2
exit 1
