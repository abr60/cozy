#!/usr/bin/env bash
# =============================================================================
# walker-restart — Restart Walker and its Elephant provider
# =============================================================================

set -uo pipefail

restart_services() {
    if systemctl --user is-enabled elephant.service >/dev/null 2>&1; then
        systemctl --user restart elephant.service
    elif pgrep -x elephant >/dev/null 2>&1; then
        pkill -x elephant || true
        setsid uwsm-app -- elephant >/dev/null 2>&1 || setsid elephant >/dev/null 2>&1 || true
    fi

    local walker_unit=app-walker@autostart.service
    # The XDG autostart unit is "generated", not enabled in the usual sense.
    # Detect it by loaded unit as well so we never kill its process and let a
    # separate manual service fight it for the dev.benz.walker bus name.
    if systemctl --user list-units --all --no-legend "$walker_unit" 2>/dev/null | grep -q . ||
       systemctl --user is-enabled "$walker_unit" >/dev/null 2>&1; then
        systemctl --user restart "$walker_unit" 2>/dev/null || true
    else
        pkill -x walker 2>/dev/null || true
        echo "Walker service is not available; start it with walker-launch." >&2
    fi
}

if (( EUID == 0 )); then
    SCRIPT_OWNER=$(stat -c '%U' "$0")
    USER_UID=$(id -u "$SCRIPT_OWNER")
    systemd-run --uid="$SCRIPT_OWNER" --setenv=XDG_RUNTIME_DIR="/run/user/$USER_UID" \
        bash -c "$(declare -f restart_services); restart_services"
else
    restart_services
fi
