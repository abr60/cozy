{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": { "keys": "red", "separator": "black" },
    "size": { "ndigits": 0, "maxPrefix": "GB" }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii_logos/origami-gradient.txt",
    "color": { "1": "bright_red", "2": "red", "3": "green", "4": "yellow", "5": "white" },
    "padding": { "top": 1, "right": 6, "left": 2 }
  },
  "modules": [
    "break",
    { "type": "custom", "key": " ", "format": "{#black}── {#red}system {#black}────────────────────" },
    { "type": "os", "key": " " },
    { "type": "host", "key": " " },
    { "type": "kernel", "key": " " },
    { "type": "uptime", "key": "󱫐 " },
    "break",
    { "type": "custom", "key": " ", "format": "{#black}── {#green}hardware {#black}──────────────────" },
    { "type": "cpu", "key": " ", "keyColor": "green" },
    { "type": "gpu", "key": " ", "keyColor": "green", "detectionMethod": "pci" },
    { "type": "memory", "key": " ", "keyColor": "green", "format": "{used} / {total} ({percentage}) {percentage-bar}", "percent": { "type": ["bar", "num"] } },
    { "type": "disk", "key": "󰋊 ", "keyColor": "green", "format": "{size-used} / {size-total} ({size-percentage}) {size-percentage-bar}", "percent": { "type": ["bar", "num"] } },
    "break",
    { "type": "custom", "key": " ", "format": "{#black}── {#yellow}session {#black}───────────────────" },
    { "type": "wm", "key": " ", "keyColor": "yellow" },
    { "type": "shell", "key": " ", "keyColor": "yellow" },
    { "type": "battery", "key": " ", "keyColor": "yellow", "format": "{capacity-bar} {capacity} [{status}]", "percent": { "type": ["bar", "num"] } },
    { "type": "colors", "key": " ", "symbol": "circle" }
  ]
}
