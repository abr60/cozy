#!/bin/bash
source "$HOME/.config/hypr/assets/lib/helpers.sh"
clear

# ── Logo ────────────────────────────────────────────────────────────────────
cat "$HOME/.config/hypr/assets/ANSI LOGO/media-downloader.txt" 2>/dev/null || echo "Media Downloader"

# ── Info Box ────────────────────────────────────────────────────────────────
gum style --border rounded --border-foreground 6 --padding "1 2" \
  "" \
  "• Ensure you have enough disk space" \
  "• Music mode embeds Cover Art & Tags" \
  "• Large playlists may take a while" \
  "" \
  "$(gum style --foreground 8 "Powered by yt-dlp")"

echo

# ── Folder Picker ───────────────────────────────────────────────────────────
# Rooted at ~/Videos/Downloaded Videos/
# Arrow-key navigation + create new folder on the fly.
# Sets global $picked_dir on success.
pick_video_dir() {
  local root="$HOME/Videos/Downloaded Videos"
  local NEW_FOLDER_LABEL="[ + Create new folder ]"
  mkdir -p "$root"

  while true; do
    local entries=()
    while IFS= read -r d; do
      entries+=("$(basename "$d")/")
    done < <(find "$root" -mindepth 1 -maxdepth 1 -type d | sort)
    entries+=("$NEW_FOLDER_LABEL")

    local choice
    choice=$(printf '%s\n' "${entries[@]}" | gum choose --header "Select download folder  ($root)")
    [[ -z "$choice" ]] && return 1

    if [[ "$choice" == "$NEW_FOLDER_LABEL" ]]; then
      local new_name
      new_name=$(gum input --prompt "New folder name: " --placeholder "e.g. Lectures")
      [[ -z "$new_name" ]] && continue
      mkdir -p "$root/$new_name"
      picked_dir="$root/$new_name"
      return 0
    else
      picked_dir="$root/${choice%/}"
      return 0
    fi
  done
}

# ── URL Input ───────────────────────────────────────────────────────────────
clip_url=$(wl-paste 2>/dev/null || true)
[[ "$clip_url" != http* ]] && clip_url=""

url=$(gum input --prompt "URL: " --placeholder "YouTube, SoundCloud, Reddit, Instagram..." --value "$clip_url")
[[ -z "$url" ]] && { log_info "Cancelled"; exit 0; }

# ── Validate ─────────────────────────────────────────────────────────────────
echo
if ! spinner "Validating URL..." yt-dlp --dump-json --quiet --no-warnings --playlist-items 1 "$url" > /dev/null 2>&1; then
  log_error "URL not supported or invalid"
  show_done
  exit 1
fi

title=$(yt-dlp --get-title --quiet --no-warnings --playlist-items 1 "$url" 2>/dev/null || echo "Unknown Title")
log_success "Found: $title"

# ── Playlist Detection ───────────────────────────────────────────────────────
echo
is_playlist=false
if echo "$url" | grep -q "list="; then
  playlist_title=$(yt-dlp --flat-playlist --dump-single-json --quiet --no-warnings "$url" 2>/dev/null \
    | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('title','Playlist'))" 2>/dev/null)
  playlist_count=$(yt-dlp --flat-playlist --dump-single-json --quiet --no-warnings "$url" 2>/dev/null \
    | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d.get('entries',[])))" 2>/dev/null)
  log_info "Playlist detected: $playlist_title ($playlist_count items)"
  echo
  playlist_choice=$(gum choose --header "What would you like to download?" "This item only" "Entire playlist")
  [[ -z "$playlist_choice" ]] && exit 0
  [[ "$playlist_choice" == "Entire playlist" ]] && is_playlist=true
fi

# ── Download Type ────────────────────────────────────────────────────────────
echo
type=$(gum choose --header "Select download type" "Video" "Music")
[[ -z "$type" ]] && exit 0

# ── VIDEO ────────────────────────────────────────────────────────────────────
if [[ "$type" == "Video" ]]; then

  # Folder picker
  echo
  picked_dir=""
  if ! pick_video_dir; then
    log_info "Cancelled"
    exit 0
  fi

  # Resolve download directory
  if $is_playlist; then
    safe_playlist_title=$(echo "$playlist_title" | tr '/:*?"<>|\\' '_')
    download_dir="$picked_dir/$safe_playlist_title"
    mkdir -p "$download_dir"
    log_info "Playlist folder: $download_dir"
  else
    download_dir="$picked_dir"
  fi

  # Quality selection
  echo
  quality=$(gum choose --header "Select video quality" \
    "Preferred Quality (1080p)" \
    "Best Quality" \
    "720p" \
    "480p" \
    "360p")
  [[ -z "$quality" ]] && { log_info "Cancelled"; exit 0; }

  case "$quality" in
    "Preferred Quality (1080p)") format_spec="bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080]" ;;
    "Best Quality")              format_spec="bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" ;;
    "720p")                      format_spec="bestvideo[height<=720][ext=mp4]+bestaudio[ext=m4a]/best[height<=720]" ;;
    "480p")                      format_spec="bestvideo[height<=480][ext=mp4]+bestaudio[ext=m4a]/best[height<=480]" ;;
    "360p")                      format_spec="bestvideo[height<=360][ext=mp4]+bestaudio[ext=m4a]/best[height<=360]" ;;
  esac

  # Subtitles — always English, moved to .subtitles/ after download
  sub_dir="$download_dir/.subtitles"
  mkdir -p "$sub_dir"
  sub_flags="--write-subs --write-auto-subs --sub-langs en"

  # Download
  echo
  if $is_playlist; then
    log_step "Downloading playlist: $playlist_title ($playlist_count videos @ $quality) [en subs]..."
    echo
    yt-dlp -f "$format_spec" \
      $sub_flags \
      --no-warnings --yes-playlist \
      --newline \
      --progress-template "download:[%(info.playlist_index)s/%(playlist_count)s] %(info.title).40s | %(progress._percent_str)s | %(progress._speed_str)s | ETA %(progress._eta_str)s" \
      --ignore-errors \
      -o "$download_dir/%(playlist_index)s - %(title)s.%(ext)s" "$url" 2>/dev/null \
      | grep --line-buffered "download:" \
      | while IFS= read -r line; do printf "\r  %s        " "$line"; done
    mv "$download_dir"/*.vtt "$sub_dir/" 2>/dev/null || true
    echo
    log_success "Playlist saved to $download_dir"
  else
    log_step "Downloading video ($quality) [en subs]..."
    yt-dlp -f "$format_spec" \
      $sub_flags \
      --no-warnings --playlist-items 1 \
      --newline \
      --progress-template "download: %(progress._percent_str)s | %(progress._speed_str)s | ETA %(progress._eta_str)s" \
      -o "$download_dir/%(title)s.%(ext)s" "$url" 2>/dev/null \
      | grep --line-buffered "%" \
      | while IFS= read -r line; do printf "\r  %s        " "$line"; done
    yt_status=${PIPESTATUS[0]}
    echo
    if [[ $yt_status -ne 0 ]]; then
      log_error "Download failed"
      show_done
      exit 1
    fi
    mv "$download_dir"/*.vtt "$sub_dir/" 2>/dev/null || true
    log_success "Video saved to $download_dir"
  fi

# ── MUSIC ────────────────────────────────────────────────────────────────────
elif [[ "$type" == "Music" ]]; then

  # Audio format — best quality first
  echo
  audio_format=$(gum choose --header "Select audio format" \
    "Best — Opus (native)" \
    "M4A / AAC (universal)" \
    "MP3 (max compatibility)" \
    "FLAC (lossless source only)")
  [[ -z "$audio_format" ]] && { log_info "Cancelled"; exit 0; }

  case "$audio_format" in
    "Best — Opus (native)")
      audio_format_lower="opus"
      audio_format_spec="bestaudio[acodec=opus]/bestaudio/best"
      audio_quality="192k"
      ;;
    "M4A / AAC (universal)")
      audio_format_lower="m4a"
      audio_format_spec="bestaudio[ext=m4a]/bestaudio/best"
      audio_quality="192k"
      ;;
    "MP3 (max compatibility)")
      audio_format_lower="mp3"
      audio_format_spec="bestaudio/best"
      audio_quality="320k"
      ;;
    "FLAC (lossless source only)")
      audio_format_lower="flac"
      audio_format_spec="bestaudio[ext=flac]/bestaudio/best"
      audio_quality="8"
      log_info "FLAC only preserves quality if the source itself is lossless"
      ;;
  esac

  # Metadata flags
  audio_root="$HOME/Music"
  mkdir -p "$audio_root"

  metadata_flags=(
    -f "$audio_format_spec"
    --extract-audio
    --audio-format "$audio_format_lower"
    --audio-quality "$audio_quality"
    --embed-thumbnail
    --embed-metadata
  )
  [[ "$audio_format_lower" == "flac" ]] && \
    metadata_flags+=(--postprocessor-args "ffmpeg:-compression_level 8")

  # Stage downloads, verify them, then promote into the library
  stage_root=$(mktemp -d "$audio_root/.cozy-media.XXXXXX") || exit 1
  manifest="$stage_root/.manifest"

  verify_staged_tracks() {
    local f errors
    while IFS= read -r f; do
      [[ -f "$f" ]] || continue
      if ! ffprobe -v error -select_streams a:0 -show_entries stream=codec_name \
             -of csv=p=0 "$f" 2>/dev/null | grep -q .; then
        log_error "No audio stream in: $f"
        return 1
      fi
      errors=$(ffmpeg -v error -i "$f" -map 0:a:0 -f null - 2>&1)
      if [[ -n "$errors" ]]; then
        log_error "Corrupt audio detected in: $f"
        return 1
      fi
    done < "$manifest"
  }

  promote_staged_tracks() {
    local f rel target_dir
    while IFS= read -r f; do
      [[ -f "$f" ]] || continue
      rel=${f#"$stage_root/"}
      target_dir="$audio_root/$(dirname "$rel")"
      mkdir -p "$target_dir" || return 1
      mv -f "$f" "$target_dir/$(basename "$rel")" || return 1
    done < "$manifest"
  }

  # Download
  echo
  if $is_playlist; then
    safe_playlist_title=$(echo "$playlist_title" | tr '/:*?"<>|\\' '_')
    out_template="$stage_root/$safe_playlist_title/%(title)s.%(ext)s"
    log_step "Downloading playlist: $playlist_title ($playlist_count items @ $audio_format)..."
    echo
    yt-dlp "${metadata_flags[@]}" \
      --no-warnings --yes-playlist --ignore-errors \
      --newline \
      --print-to-file "after_move:%(filepath)s" "$manifest" \
      --progress-template "download:[%(info.playlist_index)s/%(playlist_count)s] %(info.title).40s | %(progress._percent_str)s | %(progress._speed_str)s | ETA %(progress._eta_str)s" \
      -o "$out_template" "$url" 2>/dev/null \
      | grep --line-buffered "download:" \
      | while IFS= read -r line; do printf "\r  %s        " "$line"; done
    yt_status=${PIPESTATUS[0]}
    echo
    if [[ $yt_status -ne 0 ]]; then
      log_error "Playlist download failed"
      exit 1
    fi
  else
    out_template="$stage_root/%(title)s.%(ext)s"
    log_step "Downloading track ($audio_format)..."
    yt-dlp "${metadata_flags[@]}" \
      --no-warnings --playlist-items 1 \
      --newline \
      --print-to-file "after_move:%(filepath)s" "$manifest" \
      --progress-template "download: %(progress._percent_str)s | %(progress._speed_str)s | ETA %(progress._eta_str)s" \
      -o "$out_template" "$url" 2>/dev/null \
      | grep --line-buffered "%" \
      | while IFS= read -r line; do printf "\r  %s        " "$line"; done
    yt_status=${PIPESTATUS[0]}
    echo
    if [[ $yt_status -ne 0 ]]; then
      log_error "Audio extraction failed"
      exit 1
    fi
  fi

  if [[ ! -f "$manifest" ]]; then
    log_error "No downloaded files were reported"
    exit 1
  fi
  if ! verify_staged_tracks; then
    log_error "Verification failed — files kept in $stage_root"
    exit 1
  fi
  if ! promote_staged_tracks; then
    log_error "Failed to move files from $stage_root"
    exit 1
  fi
  rm -rf -- "$stage_root"
  log_success "Audio saved to $audio_root"

  # ── Sync Hook ──────────────────────────────────────────────────────────────
  echo
  log_step "Signaling MPD daemon to update library index..."
  mpc update

fi

# ── Auto-close Countdown ─────────────────────────────────────────────────────
echo
gum style --foreground 2 "  ✓ Done!"
echo
for i in $(seq 10 -1 1); do
  printf "\r  Closing in %d seconds... (press any key to close now)  " "$i"
  read -r -s -n1 -t1 key && break
done
echo
