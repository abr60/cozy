/* ===========================================================================
   Rofi Emoji Picker — Cozy-styled card with a big emoji grid
   Used by: bin/libexec/cozy/desktop/rofi-emoji  (SUPER+CTRL+E)
   Renders ONLY the emoji glyph in an 8-column grid via -display-columns 1;
   keywords stay hidden but searchable.
   =========================================================================== */

@import "matugen.rasi"

configuration {
    matching:       "prefix";
    case-sensitive: false;
    sort:           true;
    history:        false;
    kb-cancel:      "Escape,MousePrimary";
    hover-select:   true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

window {
    location:         center;
    anchor:           center;
    background-color: @surface;
    border:           2px;
    border-color:     @outline-variant;
    border-radius:    16px;
    width:            620px;
    height:           640px;
    padding:          24px;
    children:         [ mainbox ];
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @surface-container-low;
    border:           1px;
    border-color:     @outline-variant;
    border-radius:    10px;
    padding:          8px 14px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @primary;
    margin:     0px 10px 0px 0px;
    font:       "JetBrains Mono Nerd Font 14";
}

entry {
    placeholder:       "Search emojis…";
    placeholder-color: @on-surface-variant;
    text-color:        @on-surface-variant;
    font:              "JetBrains Mono 14";
}

listview {
    columns:       8;
    lines:         6;
    flow:          horizontal;
    spacing:       14px;
    scrollbar:     false;
    fixed-height:  false;
}

element {
    padding:     8px;
    children:    [ element-text ];
}

element normal normal,
element alternate normal {
    text-color: @on-surface-variant;
}

element selected normal {
    background-color: @primary-fixed-alpha;
    text-color:       @on-primary;
    border:           1px;
    border-color:     @primary;
    border-radius:    10px;
}

element-text {
    font: "Noto Color Emoji 26";
}
