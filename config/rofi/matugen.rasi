* {
    primary: #b4d181;
    primary-fixed: #d0ed9a;
    primary-fixed-alpha: rgba(208, 237, 154, 0.2);
    primary-fixed-dim: #b4d181;
    on-primary: #243600;
    on-primary-fixed: #131f00;
    on-primary-fixed-variant: #374e0c;
    primary-container: #354b09;
    on-primary-container: #c9e694;
    secondary: #bfcba5;
    secondary-fixed: #dbe7c0;
    secondary-fixed-dim: #bfcba5;
    on-secondary: #2a3419;
    on-secondary-fixed: #161e06;
    on-secondary-fixed-variant: #404a2d;
    secondary-container: #454f32;
    on-secondary-container: #e1edc5;
    tertiary: #91d5ac;
    tertiary-fixed: #adf2c7;
    tertiary-fixed-dim: #91d5ac;
    on-tertiary: #003921;
    on-tertiary-fixed: #002111;
    on-tertiary-fixed-variant: #045232;
    tertiary-container: #004f30;
    on-tertiary-container: #a6ebc1;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #12140f;
    surface-alpha: rgba(18, 20, 15, 0.7);
    on-surface: #e3e3da;
    on-surface-variant: #c5c8b8;
    outline: #8f9283;
    outline-variant: #45483c;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e3e3da;
    inverse-on-surface: #30312b;
    inverse-primary: #4e6623;
    surface-dim: #12140f;
    surface-bright: #383a33;
    surface-container-lowest: #0d0f0a;
    surface-container-low: #1b1c17;
    surface-container: #1f201b;
    surface-container-high: #292b25;
    surface-container-highest: #34352f;
}