* {
    primary: #ffb3ad;
    primary-fixed: #ffdad6;
    primary-fixed-alpha: rgba(255, 218, 214, 0.2);
    primary-fixed-dim: #ffb3ad;
    on-primary: #680009;
    on-primary-fixed: #410003;
    on-primary-fixed-variant: #930012;
    primary-container: #ff5450;
    on-primary-container: #000000;
    secondary: #ffb3ad;
    secondary-fixed: #ffdad6;
    secondary-fixed-dim: #ffb3ad;
    on-secondary: #621011;
    on-secondary-fixed: #410003;
    on-secondary-fixed-variant: #812724;
    secondary-container: #812724;
    on-secondary-container: #ffd7d3;
    tertiary: #ffb86c;
    tertiary-fixed: #ffdcbc;
    tertiary-fixed-dim: #ffb86c;
    on-tertiary: #492900;
    on-tertiary-fixed: #2c1600;
    on-tertiary-fixed-variant: #683c00;
    tertiary-container: #cb8022;
    on-tertiary-container: #000000;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #1e0f0e;
    surface-alpha: rgba(30, 15, 14, 0.7);
    on-surface: #fadcd9;
    on-surface-variant: #e4beba;
    outline: #ab8985;
    outline-variant: #5b403e;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #fadcd9;
    inverse-on-surface: #3e2c2a;
    inverse-primary: #ba1821;
    surface-dim: #1e0f0e;
    surface-bright: #473533;
    surface-container-lowest: #180a09;
    surface-container-low: #271716;
    surface-container: #2c1b1a;
    surface-container-high: #372624;
    surface-container-highest: #43302f;
}