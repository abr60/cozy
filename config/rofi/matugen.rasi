* {
    primary: #ffaeda;
    primary-fixed: #ffd8ea;
    primary-fixed-alpha: rgba(255, 216, 234, 0.2);
    primary-fixed-dim: #ffaeda;
    on-primary: #5d0b44;
    on-primary-fixed: #3c002a;
    on-primary-fixed-variant: #79265c;
    primary-container: #d270aa;
    on-primary-container: #000000;
    secondary: #edb7d2;
    secondary-fixed: #ffd8ea;
    secondary-fixed-dim: #edb7d2;
    on-secondary: #49243a;
    on-secondary-fixed: #301024;
    on-secondary-fixed-variant: #623a50;
    secondary-container: #623a50;
    on-secondary-container: #ffd5e9;
    tertiary: #ffb4a1;
    tertiary-fixed: #ffdbd1;
    tertiary-fixed-dim: #ffb4a1;
    on-tertiary: #601401;
    on-tertiary-fixed: #3c0800;
    on-tertiary-fixed-variant: #7f2a13;
    tertiary-container: #df7154;
    on-tertiary-container: #000000;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #191115;
    surface-alpha: rgba(25, 17, 21, 0.7);
    on-surface: #eedfe4;
    on-surface-variant: #d7c1ca;
    outline: #9f8b94;
    outline-variant: #52424a;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #eedfe4;
    inverse-on-surface: #372e32;
    inverse-primary: #963e75;
    surface-dim: #191115;
    surface-bright: #40373b;
    surface-container-lowest: #130c10;
    surface-container-low: #21191d;
    surface-container: #251d21;
    surface-container-high: #30282c;
    surface-container-highest: #3b3236;
}