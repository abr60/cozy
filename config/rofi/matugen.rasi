* {
    primary: #933c73;
    primary-fixed: #ffd8ea;
    primary-fixed-alpha: rgba(255, 216, 234, 0.2);
    primary-fixed-dim: #ffaeda;
    on-primary: #ffffff;
    on-primary-fixed: #3c002a;
    on-primary-fixed-variant: #79265c;
    primary-container: #b1548c;
    on-primary-container: #ffffff;
    secondary: #7c5269;
    secondary-fixed: #ffd8ea;
    secondary-fixed-dim: #edb7d2;
    on-secondary: #ffffff;
    on-secondary-fixed: #301024;
    on-secondary-fixed-variant: #623a50;
    secondary-container: #ffc8e3;
    on-secondary-container: #5b354b;
    tertiary: #9b3f26;
    tertiary-fixed: #ffdbd1;
    tertiary-fixed-dim: #ffb4a1;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #3c0800;
    on-tertiary-fixed-variant: #7f2a13;
    tertiary-container: #bb563b;
    on-tertiary-container: #ffffff;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f8;
    surface-alpha: rgba(255, 248, 248, 0.7);
    on-surface: #21191d;
    on-surface-variant: #52424a;
    outline: #85727a;
    outline-variant: #d7c1ca;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #372e32;
    inverse-on-surface: #fdedf2;
    inverse-primary: #ffaeda;
    surface-dim: #e5d6db;
    surface-bright: #fff8f8;
    surface-container-lowest: #ffffff;
    surface-container-low: #fff0f5;
    surface-container: #faeaef;
    surface-container-high: #f4e4e9;
    surface-container-highest: #eedfe4;
}