* {
    primary: #f3ba9e;
    primary-fixed: #ffdbcb;
    primary-fixed-alpha: rgba(255, 219, 203, 0.2);
    primary-fixed-dim: #f3ba9e;
    on-primary: #4a2714;
    on-primary-fixed: #311303;
    on-primary-fixed-variant: #653d28;
    primary-container: #976850;
    on-primary-container: #ffffff;
    secondary: #dfc0b2;
    secondary-fixed: #fcdcce;
    secondary-fixed-dim: #dfc0b2;
    on-secondary: #3f2c23;
    on-secondary-fixed: #28180f;
    on-secondary-fixed-variant: #574238;
    secondary-container: #5a443a;
    on-secondary-container: #fdddcf;
    tertiary: #d1c88f;
    tertiary-fixed: #eee4a9;
    tertiary-fixed-dim: #d1c88f;
    on-tertiary: #363106;
    on-tertiary-fixed: #201c00;
    on-tertiary-fixed-variant: #4e471b;
    tertiary-container: #b5ac76;
    on-tertiary-container: #252100;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #171211;
    surface-alpha: rgba(23, 18, 17, 0.7);
    on-surface: #ebe0dd;
    on-surface-variant: #d5c3bb;
    outline: #9e8d86;
    outline-variant: #51443e;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #ebe0dd;
    inverse-on-surface: #352f2d;
    inverse-primary: #80543d;
    surface-dim: #171211;
    surface-bright: #3e3836;
    surface-container-lowest: #110d0b;
    surface-container-low: #1f1b19;
    surface-container: #231f1d;
    surface-container-high: #2e2927;
    surface-container-highest: #393431;
}