* {
    primary: #a7d295;
    primary-fixed: #c2efaf;
    primary-fixed-alpha: rgba(194, 239, 175, 0.2);
    primary-fixed-dim: #a7d295;
    on-primary: #13380b;
    on-primary-fixed: #022100;
    on-primary-fixed-variant: #2a4f20;
    primary-container: #294e1f;
    on-primary-container: #beeaab;
    secondary: #baccaf;
    secondary-fixed: #d6e8ca;
    secondary-fixed-dim: #baccaf;
    on-secondary: #253420;
    on-secondary-fixed: #111f0c;
    on-secondary-fixed-variant: #3b4b35;
    secondary-container: #3e4d37;
    on-secondary-container: #d7eacb;
    tertiary: #95d0dd;
    tertiary-fixed: #b1ecf9;
    tertiary-fixed-dim: #95d0dd;
    on-tertiary: #00363e;
    on-tertiary-fixed: #001f25;
    on-tertiary-fixed-variant: #034e59;
    tertiary-container: #004d58;
    on-tertiary-container: #ace8f5;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #121410;
    surface-alpha: rgba(18, 20, 16, 0.7);
    on-surface: #e2e3dc;
    on-surface-variant: #c2c9bb;
    outline: #8c9387;
    outline-variant: #42493e;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e2e3dc;
    inverse-on-surface: #2f312c;
    inverse-primary: #416836;
    surface-dim: #121410;
    surface-bright: #383a35;
    surface-container-lowest: #0c0f0b;
    surface-container-low: #1a1c18;
    surface-container: #1e201c;
    surface-container-high: #282b26;
    surface-container-highest: #333531;
}