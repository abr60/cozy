* {
    primary: #ffb68a;
    primary-fixed: #ffdbc8;
    primary-fixed-alpha: rgba(255, 219, 200, 0.2);
    primary-fixed-dim: #ffb68a;
    on-primary: #522300;
    on-primary-fixed: #321300;
    on-primary-fixed-variant: #743400;
    primary-container: #a64e01;
    on-primary-container: #ffffff;
    secondary: #f7b995;
    secondary-fixed: #ffdbc8;
    secondary-fixed-dim: #f7b995;
    on-secondary: #4c270c;
    on-secondary-fixed: #321300;
    on-secondary-fixed-variant: #673c20;
    secondary-container: #673c20;
    on-secondary-container: #ffd8c3;
    tertiary: #c9cc61;
    tertiary-fixed: #e5e97a;
    tertiary-fixed-dim: #c9cc61;
    on-tertiary: #313300;
    on-tertiary-fixed: #1c1d00;
    on-tertiary-fixed-variant: #484a00;
    tertiary-container: #686b00;
    on-tertiary-container: #ffffff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #1a110c;
    surface-alpha: rgba(26, 17, 12, 0.7);
    on-surface: #f1dfd6;
    on-surface-variant: #dcc1b3;
    outline: #a48c7f;
    outline-variant: #554338;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f1dfd6;
    inverse-on-surface: #392e28;
    inverse-primary: #994700;
    surface-dim: #1a110c;
    surface-bright: #423731;
    surface-container-lowest: #150c08;
    surface-container-low: #231a14;
    surface-container: #271e18;
    surface-container-high: #322822;
    surface-container-highest: #3e322c;
}