{
  "custom/menu": {
    "format": "󰮫",
    "menu": "on-click",
    "tooltip": false,
    "menu-file": "$HOME/.config/waybar/menu/style-menu.xml",
    "menu-actions": {
      "mode_dark":  "cozy-set-mode dark",
      "mode_light": "cozy-set-mode light",

      "scheme_tonal_spot":  "cozy-matugen-scheme --apply scheme-tonal-spot",
      "scheme_content":     "cozy-matugen-scheme --apply scheme-content",
      "scheme_expressive":  "cozy-matugen-scheme --apply scheme-expressive",
      "scheme_fidelity":    "cozy-matugen-scheme --apply scheme-fidelity",
      "scheme_fruit_salad": "cozy-matugen-scheme --apply scheme-fruit-salad",
      "scheme_monochrome":  "cozy-matugen-scheme --apply scheme-monochrome",
      "scheme_neutral":     "cozy-matugen-scheme --apply scheme-neutral",
      "scheme_rainbow":     "cozy-matugen-scheme --apply scheme-rainbow",
      "scheme_vibrant":     "cozy-matugen-scheme --apply scheme-vibrant",

      "theme_canvas":      "cozy-apply-theme Canvas",
      "theme_emerald":     "cozy-apply-theme Emerald",
      "theme_graffiti":    "cozy-apply-theme Graffiti",
      "theme_landscape":   "cozy-apply-theme Landscape",
      "theme_monochrome":  "cozy-apply-theme Monochrome",
      "theme_pixelpulse":  "cozy-apply-theme Pixelpulse",
      "theme_spectrum":    "cozy-apply-theme Spectrum",
      "theme_sumie":       "cozy-apply-theme Sumi-e",

      "wallpaper_select": "rofi-set-bg",
      "wallpaper_next":   "cozy-wallpaper-cycle next",
      "wallpaper_prev":   "cozy-wallpaper-cycle prev",
      "wallpaper_random": "cozy-wallpaper-cycle random",

      "anim_fast":   "ln -sf ~/.config/hypr/animations/fast.lua ~/.config/hypr/animations.lua && hyprctl reload",
      "anim_fluid":  "ln -sf ~/.config/hypr/animations/fluid.lua ~/.config/hypr/animations.lua && hyprctl reload",
      "anim_disabled": "ln -sf ~/.config/hypr/animations/disabled.lua ~/.config/hypr/animations.lua && hyprctl reload",

      "waybar_style_minimal":   "waybar-control style minimal",
      "waybar_style_intricate": "waybar-control style intricate",

      "waybar_top":    "waybar-control position top",
      "waybar_bottom": "waybar-control position bottom",
      "waybar_left":   "waybar-control position left",
      "waybar_right":  "waybar-control position right",

      "rescan_menu": "generate-menu && pkill -SIGUSR2 waybar"
    }
  }
}
