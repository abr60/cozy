{
  "include": [
    "overrides/vertical.jsonc",
    "modules/*.jsonc",
    "modules/groups/common.jsonc"
  ],

  "name": "left",
  "position": "left",
  "exclusive": true,
  "reload_style_on_change": true,
  "margin-top": 0,
  "margin-bottom": 0,
  "spacing": 0,
  "height": 0,

  "modules-left": [
    "hyprland/workspaces",
    "custom/separator",
    "custom/voxtype",
    "custom/idle-indicator",
    "custom/notification-silencing-indicator",
    "custom/screenrecording-indicator",
    "custom/updatespacman"
  ],

  "modules-center": [
    "mpris"
  ],

  "modules-right": [
    "group/tray-expander",
    "backlight",
    "bluetooth",
    "network",
    "pulseaudio",
    "power-profiles-daemon",
    "battery",
    "custom/vpn",
    "custom/menu",
    "clock"
  ]
}
