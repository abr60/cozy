# --- ENVS & PATH ---
export EDITOR=nvim
export VISUAL=nvim
export ZSH="$HOME/.oh-my-zsh"
export COZY_PATH="${COZY_PATH:-$HOME/.local/share/Cozy}"
export COZY_DIR="$COZY_PATH"

# Keep PATH clean when nested shells re-source this file
typeset -U path
path+=("$HOME/.spicetify" "$HOME/.cargo/bin" "$HOME/.config/hypr/scripts")

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

# History and Monitor Options
setopt appendhistory
setopt NO_NOTIFY
setopt NO_MONITOR
setopt extended_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_save_no_dups
setopt hist_reduce_blanks
setopt share_history

# Oh My Zsh Theme & Plugins (Required before oh-my-zsh.sh)
# Prompt is defined in ~/zshrc/prompt, so no OMZ theme is needed.
ZSH_THEME=""
plugins=(
  sudo
  zsh-autosuggestions
  fast-syntax-highlighting
)

# Load Oh My Zsh Core (never let a missing install break the shell)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 -- "zsh: Oh My Zsh not found at $ZSH — continuing without it"
fi
