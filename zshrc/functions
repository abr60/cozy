# --- FUNCTIONS ---
zi() {
  local target
  target="$(zoxide query -i 2>/dev/null)" || return 1
  [[ -n "$target" ]] && builtin cd -- "$target"
}

zd() {
  if (( $# == 0 )); then
    builtin cd ~ && return
  elif [[ -d "$1" ]]; then
    builtin cd -- "$1"
  elif command -v zoxide >/dev/null 2>&1; then
    local target
    target="$(z "$@" 2>/dev/null)" || return 1
    [[ -n "$target" ]] && builtin cd -- "$target" && printf "\U000F17A9 " && pwd
  else
    print -u2 -- "zd: no such directory: $1"
    return 1
  fi
}

open() { xdg-open "$@" >/dev/null 2>&1 & }
cp2c() { [[ -z "$1" ]] && return 1; wl-copy < "$1"; }
c2f() { [[ -z "$1" ]] && return 1; wl-paste > "$1"; }

# Waydroid Hider logic
hide_waydroid() {
  sh -c 'find "$HOME/.local/share/applications" -name "waydroid.*.desktop" -exec grep -L "NoDisplay=true" {} + | xargs -I {} sed -i "/\[Desktop Entry\]/a NoDisplay=true" {}' 2>/dev/null
}

cozy() {
    local msg="${1:-sync: $(date +%Y-%m-%d\ %H:%M)}"
    cd "$COZY_PATH" && \
    git add . && \
    git commit -m "$msg" && \
    git push && \
    cd -
}

# Load the maintenance helper only when it is actually invoked.
cleancozy() {
  local _args=("$@")
  unfunction cleancozy
  source "$HOME/zshrc/cleancozy"
  cleancozy "${_args[@]}"
}
